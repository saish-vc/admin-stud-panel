{
  "name": "nttf-certificate-portal",
  "version": "1.0.0",
  "private": true,
  "description": "NTTF student certificate request, administration, verification, and issuance portal",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @nttf/api\" \"npm run dev -w @nttf/web\"",
    "dev:api": "npm run dev -w @nttf/api",
    "dev:web": "npm run dev -w @nttf/web",
    "build": "npm run build -w @nttf/web && npm run build -w @nttf/api",
    "start": "npm run start -w @nttf/api",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "npm run typecheck -w @nttf/api && npm run typecheck -w @nttf/web && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project api-unit --project web-unit",
    "test:integration": "vitest run --project api-integration",
    "test:security": "vitest run --project api-integration -- tests/integration/security.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "k6 run e2e/performance/load-test.js",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "db:generate": "npm run db:generate -w @nttf/api",
    "db:migrate": "npm run db:migrate -w @nttf/api",
    "db:seed": "npm run db:seed -w @nttf/api",
    "db:seed:e2e": "npm run db:seed:e2e -w @nttf/api",
    "db:studio": "npm run db:studio -w @nttf/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate:prod": "node apps/api/dist/migrate.js",
    "docker:build": "npm run docker:build:api && npm run docker:build:web",
    "docker:build:api": "docker build -f deploy/api.Dockerfile -t nttf-portal-api:local .",
    "docker:build:web": "docker build -f deploy/web.Dockerfile -t nttf-portal-web:local .",
    "deploy:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "deploy:down": "docker compose -f docker-compose.prod.yml down",
    "deploy:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=200",
    "prepare:e2e": "node scripts/prepare-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.1.1",
    "concurrently": "10.0.7",
    "dotenv": "17.2.1",
    "drizzle-orm": "0.45.4",
    "eslint": "9.34.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
