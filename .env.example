# -----------------------------------------------------------------------------
# NTTF Certificate Portal environment template.
# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ENABLE_DOCS=true

# PostgreSQL 16 (docker-compose maps 5433)
DATABASE_URL=postgresql://nttf:CHANGE_ME_LOCAL_PASSWORD@localhost:5433/nttf_portal
TEST_DATABASE_URL=postgresql://nttf:CHANGE_ME_LOCAL_PASSWORD@localhost:5433/nttf_portal_test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both secrets must differ and be at least 32 characters.
JWT_SECRET=CHANGE_ME_GENERATE_48_BYTE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_48_BYTE_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Password and abuse controls
BCRYPT_COST=12
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WINDOW_MINUTES=1
MAX_UPLOAD_BYTES=5242880

# Storage: local in development, s3 in production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=nttf-certificates
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=false

# Seed values (local/demo only). Must be replaced in any shared environment.
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_SEED_PASSWORD
SEED_FORCE_PASSWORD_CHANGE=true
SEED_STUDENT_COUNT=1000
