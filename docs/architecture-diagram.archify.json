{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "NTTF Certificate Portal Architecture",
    "locale": "en",
    "output": "docs/architecture-diagram.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "request-path",
        "label": "Authenticated request path",
        "focus": ["spa", "proxy", "api", "auth", "workflow", "db"],
        "note": "Every request passes TLS and CORS, then JWT verification and role checks before reaching workflow logic."
      },
      {
        "id": "issuance",
        "label": "Approval and issuance",
        "focus": ["workflow", "pdf", "storageAdapter", "obj", "audit", "db"],
        "note": "HOD approval renders the PDF, stores a private object, records the certificate, and audits the transition."
      },
      {
        "id": "public-verify",
        "label": "Public QR verification",
        "focus": ["verifier", "proxy", "api", "db"],
        "note": "The QR link is unauthenticated, rate limited, and returns only the minimum certificate fields."
      }
    ]
  },
  "components": [
