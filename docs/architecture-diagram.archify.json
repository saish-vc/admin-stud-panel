      "labelAt": [785, 416]
    },
    {
      "id": "pdf-to-storage",
      "from": "pdf",
      "to": "storageAdapter",
      "label": "store PDF",
      "labelAt": [1000, 416]
    },
    {
      "id": "storage-to-objects",
      "from": "storageAdapter",
      "to": "obj",
      "label": "private write",
      "labelAt": [1125, 416]
    },
    {
      "id": "api-to-logs",
      "from": "api",
      "to": "logs",
      "label": "JSON logs",
      "variant": "dashed",
      "labelAt": [360, 416]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Verification and issuance",
      "items": [
        "Clerk verifies documents; only HOD or SUPER_ADMIN approves or rejects",
        "Approval renders a QR-bearing PDF and moves the request to READY"
      ]
    },
    {
      "dot": "rose",
      "title": "Integrity and privacy",
      "items": [
        "Audit rows are insert-only via a PostgreSQL trigger",
        "Public verification excludes email, phone, DOB, remarks, and file links"
      ]
    }
  ]
}
