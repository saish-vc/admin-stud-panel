# -----------------------------------------------------------------------------
# Production template for docker-compose.prod.yml.
# Copy to .env (compose reads it automatically) and replace every CHANGE_ME.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
POSTGRES_USER=nttf
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD
POSTGRES_DB=nttf_portal

# Use a URL-safe password above, or percent-encode it here.
DATABASE_URL=postgresql://nttf:CHANGE_ME_URL_SAFE_PASSWORD@db:5432/nttf_portal

# Two different values, at least 32 characters each.
JWT_SECRET=CHANGE_ME_GENERATE_48_BYTE_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_SECRET

# Public origin users open in a browser; must match the TLS host and WEB_ORIGIN.
PUBLIC_ORIGIN=https://portal.example.org
HTTP_PORT=8080

LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WINDOW_MINUTES=1
MAX_UPLOAD_BYTES=5242880
IMAGE_TAG=1.0.0

# Storage: local (named volume, default) or s3.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=nttf-certificates
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=false

# Optional, only for the `seed` compose profile (demo/initial provisioning).
# Remove after the first run; never keep the demo seed password in production.
# SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_SEED_PASSWORD
# SEED_STUDENT_COUNT=1000
# SEED_FORCE_PASSWORD_CHANGE=true
